#!/bin/sh
# Gemini Flash + Pro/Codex review before push — blocks until review completes
# Review output is shown to whoever is pushing (Claude, builder, or you)
if [ -f "$HOME/.claude/scripts/review-router.sh" ]; then
  echo ""
  echo "═══ Pre-push review ═══"
  bash "$HOME/.claude/scripts/review-router.sh" push 2>&1 || true
  echo "═══════════════════════"
  echo ""
fi
