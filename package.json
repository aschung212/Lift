{
  "name": "lift",
  "version": "1.0.0",
  "type": "module",
  "description": "A PWA workout tracker for logging sets, tracking progress, and hitting PRs.",
  "scripts": {
    "css:extract-themes": "node scripts/rewrite-css.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase migration up",
    "db:new": "npx supabase migration new",
    "db:status": "npx supabase migration list",
    "db:diff": "npx supabase db diff",
    "db:types": "npx supabase gen types --linked --lang typescript 2>/dev/null > src/lib/database.types.ts",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "cap:build": "CAPACITOR_BUILD=true npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@sentry/vue": "^10.54.0",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "html-to-image": "^1.11.13",
    "pinia": "^3.0.4",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.3.2"
  },
  "lint-staged": {
    "src/**/*.{js,ts,vue}": [
      "eslint --max-warnings 5"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.4",
    "esbuild": ">=0.25.0",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0"
  }
}
